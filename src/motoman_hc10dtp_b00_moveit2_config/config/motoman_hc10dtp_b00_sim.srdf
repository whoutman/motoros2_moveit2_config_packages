<?xml version="1.0" encoding="UTF-8"?>
<!-- Simulation-only SRDF: mirrors motoman_hc10dtp_b00.srdf but uses group_1_ names to match the Gazebo-safe robot description. -->
<robot name="motoman_hc10dtp_b00">
    <virtual_joint name="world_to_group_1_base_link" type="fixed" parent_frame="world" child_link="group_1_base_link"/>
    <group name="manipulator">
        <chain base_link="group_1_base_link" tip_link="group_1_tool0"/>
    </group>
    <group_state name="home" group="manipulator">
        <joint name="group_1_joint_1" value="0"/>
        <joint name="group_1_joint_2" value="0"/>
        <joint name="group_1_joint_3" value="0"/>
        <joint name="group_1_joint_4" value="0"/>
        <joint name="group_1_joint_5" value="0"/>
        <joint name="group_1_joint_6" value="0"/>
    </group_state>
    <disable_collisions link1="group_1_base_link" link2="group_1_link_1" reason="Adjacent"/>
    <disable_collisions link1="group_1_base_link" link2="group_1_link_3" reason="Never"/>
    <disable_collisions link1="group_1_link_1" link2="group_1_link_2" reason="Adjacent"/>
    <disable_collisions link1="group_1_link_1" link2="group_1_link_3" reason="Never"/>
    <disable_collisions link1="group_1_link_2" link2="group_1_link_3" reason="Adjacent"/>
    <disable_collisions link1="group_1_link_2" link2="group_1_link_4" reason="Never"/>
    <disable_collisions link1="group_1_link_3" link2="group_1_link_4" reason="Adjacent"/>
    <disable_collisions link1="group_1_link_3" link2="group_1_link_5" reason="Never"/>
    <disable_collisions link1="group_1_link_3" link2="group_1_link_6" reason="Never"/>
    <disable_collisions link1="group_1_link_4" link2="group_1_link_5" reason="Adjacent"/>
    <disable_collisions link1="group_1_link_4" link2="group_1_link_6" reason="Never"/>
    <disable_collisions link1="group_1_link_5" link2="group_1_link_6" reason="Adjacent"/>
</robot>
